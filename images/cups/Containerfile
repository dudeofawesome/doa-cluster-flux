# renovate: datasource=docker depName=docker.io/aguslr/cups
ARG CUPS_VERSION=20260805@sha256:26e094c0a219a40b98ecbfc3b248e96bf3ce542d7f510ffccd5330a091f03871
FROM docker.io/aguslr/cups:${CUPS_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends libnss-mdns \
  && rm -rf /var/lib/apt/lists/*

# Use the host Avahi daemon for forward and reverse multicast DNS. The normal
# mdns module is intentional: the minimal variant rejects reverse lookups for
# private addresses, which CUPS needs when selecting its server certificate.
RUN sed -i \
  's/^hosts:.*/hosts: files mdns dns/' \
  /etc/nsswitch.conf
