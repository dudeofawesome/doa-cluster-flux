FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS build

# Upstream release binaries require glibc. Build statically for Alpine instead.
# Updating the version also requires updating the source archive checksum.
ARG AVAHI2DNS_VERSION=0.2.1
ARG TARGETARCH
WORKDIR /src
RUN wget -O /tmp/source.tar.gz \
    "https://github.com/LouisBrunner/avahi2dns/archive/refs/tags/${AVAHI2DNS_VERSION}.tar.gz" \
  && echo '3e40b1bb9d4d5b5c21c2b3de13773fbe4abbf1f34419eb91ac03c797a9930ac74a0aabd0f7f201b89579909173a61468a609afde5ad7d682c736fcffd17f3907  /tmp/source.tar.gz' | sha512sum -c - \
  && tar -xzf /tmp/source.tar.gz --strip-components=1 \
  && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w' -o /out/avahi2dns .

FROM docker.io/library/alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache bind-tools
COPY --from=build --chmod=0555 /out/avahi2dns /usr/local/bin/avahi2dns

USER 65534:65534
RUN /usr/local/bin/avahi2dns --help
ENTRYPOINT ["/usr/local/bin/avahi2dns"]
