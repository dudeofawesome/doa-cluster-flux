FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build

# Upstream release binaries require glibc. Build statically for Alpine instead.
# Renovate updates the release and source archive checksum together.
ARG AVAHI2DNS_VERSION=0.2.1
ARG AVAHI2DNS_SHA512=4c2ec1519521999227cdc3d59b54a7f9919ddec413a4ec8aa69a08bff68f5adb6ffebb1277abafb7e1d639d91421c2c1ded0049328edd86b54f031a3b2b59db4
ARG TARGETARCH
WORKDIR /src
RUN wget -O /tmp/source.tar.gz \
    "https://github.com/LouisBrunner/avahi2dns/archive/refs/tags/${AVAHI2DNS_VERSION}.tar.gz" \
  && echo "${AVAHI2DNS_SHA512}  /tmp/source.tar.gz" | sha512sum -c - \
  && tar -xzf /tmp/source.tar.gz --strip-components=1 \
  && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w' -o /out/avahi2dns .

FROM docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache bind-tools
COPY --from=build --chmod=0555 /out/avahi2dns /usr/local/bin/avahi2dns

USER 65534:65534
RUN /usr/local/bin/avahi2dns --help
ENTRYPOINT ["/usr/local/bin/avahi2dns"]
