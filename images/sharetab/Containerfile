# Build context is the pinned upstream source, with our entrypoint added by CI.
FROM node:22-alpine AS builder
WORKDIR /app
ENV DOCKER_BUILD=1
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npx prisma generate && npm run build
ARG COMMIT_SHA=unknown
RUN echo "$COMMIT_SHA" > .commit-sha

FROM node:22-alpine AS runner
WORKDIR /app
# Client utilities only: no PostgreSQL server or database initialization tools.
RUN apk add --no-cache postgresql16-client && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs
ENV NODE_ENV=production \
    HOME=/home/nextjs \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/.commit-sha ./.commit-sha
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./
COPY --from=builder /app/src/generated ./src/generated
COPY --from=builder /app/node_modules/@rynfar/meridian ./node_modules/@rynfar/meridian
COPY --from=builder /app/node_modules/@anthropic-ai/claude-agent-sdk ./node_modules/@anthropic-ai/claude-agent-sdk
WORKDIR /prisma-cli
COPY --from=builder /app/node_modules/prisma/package.json /tmp/prisma-package.json
RUN npm init -y && \
    npm install --legacy-peer-deps \
      "prisma@$(node -p 'require("/tmp/prisma-package.json").version')" \
      dotenv@17.3.1
WORKDIR /app
COPY docker/app-entrypoint.sh /app/entrypoint.sh
COPY docker/claude /usr/local/bin/claude
RUN chmod +x /app/entrypoint.sh /usr/local/bin/claude && \
    mkdir -p /data /home/nextjs /app/.next/cache && \
    chown -R nextjs:nodejs /data /home/nextjs /app/.next/cache
USER 1001:1001
EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
