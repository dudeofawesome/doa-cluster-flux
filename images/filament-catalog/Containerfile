FROM docker.io/library/python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e
ARG CATALOG_VERSION=0.1.0
LABEL org.opencontainers.image.title="Spoolman OFD catalog adapter" \
      org.opencontainers.image.source="https://github.com/dudeofawesome/doa-cluster-flux" \
      org.opencontainers.image.version="${CATALOG_VERSION}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY catalog.py test_catalog.py ./
RUN python -m unittest -v test_catalog
USER 1000:1000
ENTRYPOINT ["python", "/app/catalog.py"]
CMD ["refresh"]
