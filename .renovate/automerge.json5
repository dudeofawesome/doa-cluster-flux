{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Only the approved updates below may merge unattended.
  automerge: false,
  automergeType: 'pr',
  // GitHub has no required checks; let Renovate evaluate applicable checks.
  platformAutomerge: false,
  separateMinorPatch: true,

  packageRules: [
    {
      description: 'Automerge approved image patches and digests',
      matchDatasources: ['docker'],
      matchPackageNames: [
        'alpine/git',
        'codeberg.org/forgejo/forgejo',
        'docker.io/brainicism/bgutil-ytdlp-pot-provider',
        'docker.io/squat/generic-device-plugin',
        'docker.io/thomseddon/traefik-forward-auth',
        'ghcr.io/inditextech/redkey-robin',
        'ghcr.io/utkuozdemir/nvidia_gpu_exporter',
        'quay.io/keycloak/keycloak',
        'quay.io/operator-framework/catalogd',
        'quay.io/operator-framework/operator-controller',
        'registry.k8s.io/nfd/node-feature-discovery',
      ],
      matchUpdateTypes: ['patch', 'digest'],
      automerge: true,
    },
    {
      description: 'Automerge approved image minors, patches, and digests',
      matchDatasources: ['docker'],
      matchPackageNames: [
        'docker.io/allangood/rtlamr2mqtt',
        'docker.io/binwiederhier/ntfy',
        'docker.io/freikin/dawarich',
        'docker.io/grafana/grafana',
        'docker.io/library/node',
        'docker.io/louislam/uptime-kuma',
        'docker.io/mauriceboe/trek',
        'docker.io/tobiasehlert/teslamateapi',
        'ghcr.io/atuinsh/atuin',
        'ghcr.io/dudeofawesome/avahi2dns',
        'ghcr.io/dudeofawesome/sharetab',
        'ghcr.io/esphome/esphome',
        'ghcr.io/fire-devils/filaman-system',
        'ghcr.io/mealie-recipes/mealie',
        'ghcr.io/renovatebot/renovate',
        'ghcr.io/roxxas96/uptime-kuma-operator',
      ],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      description: 'Automerge approved chart patches',
      matchManagers: ['flux'],
      matchDepNames: [
        'cert-manager',
        'dcgm-exporter',
        'kube-prometheus-stack',
        'node-feature-discovery',
        'reflector',
        'renovate-operator',
        'traefik',
        'uptime-kuma-operator',
      ],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      description: 'Automerge approved chart minors',
      matchManagers: ['flux'],
      matchDepNames: ['traefik', 'kube-prometheus-stack'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },

    {
      description: 'Propose one-minor-at-a-time',
      matchManagers: ['flux'],
      matchDepNames: ['cert-manager'],
      separateMultipleMinor: true,
    },

    {
      description: 'Automerge OperatorHub catalog digest refreshes',
      matchPackageNames: ['quay.io/operatorhubio/catalog'],
      matchUpdateTypes: ['digest'],
      automerge: true,
    },
  ],
}
