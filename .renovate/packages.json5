{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    {
      description: 'Treat New API release candidates as SemVer prereleases',
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/calciumion/new-api'],
      versioning: 'semver',
    },
    {
      description: 'Ignore the broken catalogd v1.18.0 release',
      matchDatasources: ['docker'],
      matchDepNames: ['quay.io/operator-framework/catalogd'],
      allowedVersions: '!/^v1\\.18\\.0$/',
    },
  ],
}
