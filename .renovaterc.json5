{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: ['config:best-practices'],

  customManagers: [
    {
      description: 'Hermes agent image tag and digest',
      customType: 'regex',
      managerFilePatterns: ['/^apps/home/hermes/instance\\.ya?ml$/'],
      matchStrings: [
        'image:\\s*\\r?\\n[ \\t]+repository: [\'"]?(?<depName>[^\\s\'"]+)[\'"]?\\r?\\n[ \\t]+tag: [\'"]?(?<currentValue>[^\\s\'"]+)[\'"]?\\r?\\n[ \\t]+digest: [\'"]?(?<currentDigest>sha256:[a-f0-9]+)[\'"]?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      description: 'annotated image references in nonstandard YAML fields',
      customType: 'regex',
      managerFilePatterns: [
        '/^apps/monitoring/grafana/grafana\\.ya?ml$/',
        '/^infrastructure/operators/kubeai/release\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=docker depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\r?\\n\\s*[\\w-]+: [\'"]?[^\\s@\'"]+:(?<currentValue>[^\\s@\'"]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\'"]?(?:\\r?\\n|$)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}',
    },
    {
      description: 'annotated operator version channels',
      customType: 'regex',
      managerFilePatterns: ['/^infrastructure/operators/.+[.]ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) extractVersion=(?<extractVersion>\\S+) versioning=(?<versioning>\\S+)\\n\\s*channels: \\[(?<currentValue>v[0-9]+)\\]',
      ],
      versioningTemplate: '{{{versioning}}}',
    },
    {
      description: 'Zigbee2MQTT configuration file schema version',
      customType: 'regex',
      managerFilePatterns: [
        '/^apps/home/zigbee2mqtt/z2m-configuration\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n# yaml-language-server: \\$schema=https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/refs/tags/(?<currentValue>[^/\\s]+)/lib/util/settings\\.schema\\.json',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      description: 'annotated operator versions',
      customType: 'regex',
      managerFilePatterns: ['/^infrastructure/operators/.+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\n\\s*version: [\'"](?<currentValue>[^\'"]+)[\'"]',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      description: 'OLM catalog digests',
      customType: 'regex',
      managerFilePatterns: ['/^olm/catalogs\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s*ref: \\S+@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      currentValueTemplate: 'latest',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}',
    },
  ],

  kubernetes: {
    managerFilePatterns: [
      '/^apps/.+\\.ya?ml$/',
      '/^infrastructure/.+\\.ya?ml$/',
      '/^olm/.+\\.ya?ml$/',
      '/^services/.+\\.ya?ml$/',
      '/^sources/.+\\.ya?ml$/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/^apps/.+\\.ya?ml$/',
      '/^clusters/.+/gotk-components\\.ya?ml$/',
      '/^infrastructure/.+\\.ya?ml$/',
      '/^olm/.+\\.ya?ml$/',
      '/^services/.+\\.ya?ml$/',
      '/^sources/.+\\.ya?ml$/',
    ],
  },

  packageRules: [
    {
      description: 'Group Zigbee2MQTT image and schema updates',
      matchDepNames: ['docker.io/koenkk/zigbee2mqtt', 'Koenkk/zigbee2mqtt'],
      groupName: 'Zigbee2MQTT',
    },
    {
      description: 'Group OLM controller image updates',
      matchDatasources: ['docker'],
      matchDepNames: [
        'quay.io/operator-framework/catalogd',
        'quay.io/operator-framework/operator-controller',
      ],
      groupName: 'OLM',
    },
    {
      description: 'Ignore the broken catalogd v1.18.0 release',
      matchDatasources: ['docker'],
      matchDepNames: ['quay.io/operator-framework/catalogd'],
      allowedVersions: '!/^v1\\.18\\.0$/',
    },
    {
      description: 'Automerge OLM catalog digest updates',
      matchDatasources: ['docker'],
      matchDepNames: ['quay.io/operatorhubio/catalog'],
      matchUpdateTypes: ['digest'],
      automerge: true,
    },
    {
      description: 'Automerge patch updates to the reflector Helm release',
      matchManagers: ['flux'],
      matchDatasources: ['helm'],
      matchDepNames: ['reflector'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
