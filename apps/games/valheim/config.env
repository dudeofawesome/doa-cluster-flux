TZ=America/Los_Angeles
SERVER_NAME=Sequoia Valheim
WORLD_NAME=Sequoia
SERVER_PORT=2456
SERVER_PUBLIC=true
CROSSPLAY=false
PUBLIC_TEST=false
VALHEIM_PLUS=false
BEPINEX=false
PUID=1000
PGID=1000
# Apply the normal baseline before the portal and skill-loss overrides.
# Normal death behavior drops equipment and inventory into the grave.
SERVER_ARGS=-saveinterval 900 -backups 4 -preset normal -modifier portals casual -setkey SkillReductionRate 0
# Disable scheduled updates/restarts; Steam still updates on container startup.
UPDATE_CRON=
RESTART_CRON=
BACKUPS=true
BACKUPS_CRON=5 * * * *
BACKUPS_DIRECTORY=/config/backups
BACKUPS_MAX_AGE=7
BACKUPS_MAX_COUNT=168
BACKUPS_IF_IDLE=false
SUPERVISOR_HTTP=false
STATUS_HTTP=false
