TZ=America/Los_Angeles
DEBUG=false
LOG_LEVEL=WARNING
CORS_ORIGINS=https://filaman.orleans.io
ADMIN_EMAIL=louis@orleans.io
ADMIN_DISPLAY_NAME=Louis
ADMIN_LANGUAGE=en
ADMIN_SUPERADMIN=true
RUN_MIGRATIONS_IN_APP=false
PLUGINS_DIR=/app/data/plugins
# UI-installed plugin dependencies persist alongside the plugins.
UV_CONFIG_FILE=/etc/filaman/uv.toml
PIP_TARGET=/app/data/python
PYTHONPATH=/app/data/python
UV_CACHE_DIR=/tmp/uv-cache
PIP_CACHE_DIR=/tmp/pip-cache
