RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
SELF_HOSTED=true
STORE_GEODATA=true
TIME_ZONE=America/Los_Angeles
HOME=/tmp
APPLICATION_URL=https://dawarich.orleans.io
APPLICATION_HOST=dawarich.orleans.io
APPLICATION_HOSTS=dawarich.orleans.io,localhost,127.0.0.1
APPLICATION_PROTOCOL=https
DATABASE_HOST=postgres-rw
DATABASE_PORT=5432
DATABASE_NAME=dawarich
REDIS_URL=redis://redis:6379/0
RAILS_CACHE_DB=1
WEB_CONCURRENCY=1
RAILS_MIN_THREADS=5
RAILS_MAX_THREADS=10
BACKGROUND_PROCESSING_CONCURRENCY=3
PHOTON_API_HOST=app.chibigeo.com/v1/photon
PHOTON_API_USE_HTTPS=true
OIDC_CLIENT_ID=dawarich
OIDC_ISSUER=https://auth.orleans.io/realms/sequoia
OIDC_DISCOVERY=true
OIDC_PKCE_ENABLED=true
OIDC_REDIRECT_URI=https://dawarich.orleans.io/users/auth/openid_connect/callback
OIDC_PROVIDER_NAME=Sequoia
OIDC_AUTO_REGISTER=true
ALLOW_EMAIL_PASSWORD_LOGIN=false
ALLOW_EMAIL_PASSWORD_REGISTRATION=false
